{
    "name": "uiid/sdk-php",
    "description": "PHP SDK and Cookbook for UIID API v1",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Linkspreed Unity",
            "email": "hello@linkspreed.com"
        }
    ],
    "require": {
        "php": ">=8.1",
        "guzzlehttp/guzzle": "^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "UIID\\SDK\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "UIID\\SDK\\Tests\\": "tests/"
        }
    }
}
